# Neon pooled Postgres connection string.
DATABASE_URL=
# Secret of at least 32 random bytes used to sign session cookies.
SESSION_SECRET=
# Random salt used before hashing visitor IP addresses.
IP_HASH_SALT=
# Maximum new sessions per IP each day; set 0 to disable.
DAILY_SESSIONS_PER_IP=20
# Preview-only comma-separated reel override; ignored in production.
FORCE_REELS=
# Telephone number used by the claim call link.
CLAIM_PHONE=
# SharpSpring account identifier.
SHARPSPRING_ACCOUNT_ID=
# SharpSpring API secret key.
SHARPSPRING_SECRET_KEY=
# SharpSpring custom-field system name for discount.
SHARPSPRING_FIELD_DISCOUNT=
# SharpSpring custom-field system name for win reference.
SHARPSPRING_FIELD_WIN_REF=
# SharpSpring custom-field system name for lead source.
SHARPSPRING_FIELD_SOURCE=
# Bearer secret protecting the CRM retry cron.
CRON_SECRET=
# HTTP Basic username for staff routes.
ADMIN_USER=
# HTTP Basic password for staff routes.
ADMIN_PASSWORD=
# Public privacy-notice URL shown beside consent.
PRIVACY_URL=
# Days to retain synced leads before cleanup.
LEAD_RETENTION_DAYS=730
