# Neon pooled Postgres connection string.
DATABASE_URL=
# Secret of at least 32 random bytes used to sign session cookies.
SESSION_SECRET=
# Random salt used before hashing visitor IP addresses.
IP_HASH_SALT=
# Maximum new sessions per IP each day; set 0 to disable.
DAILY_SESSIONS_PER_IP=20
# Preview-only comma-separated reel override; ignored in production.
FORCE_REELS=
