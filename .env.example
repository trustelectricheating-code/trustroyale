# Neon pooled Postgres connection string. Run `pnpm db:migrate` against it before deploying
# (002_lead_region.sql adds leads.region; /api/lead needs it).
DATABASE_URL=
# Secret of at least 32 random bytes used to sign session cookies.
SESSION_SECRET=
# Random salt used before hashing visitor IP addresses.
IP_HASH_SALT=
# Maximum new sessions per IP each day; set 0 to disable.
DAILY_SESSIONS_PER_IP=20
# Preview-only comma-separated reel override; ignored in production.
FORCE_REELS=
# SharpSpring web-form postback: the receivePostback URL of the Trust Royale game claim form.
# Leave unset locally and in tests: with no URL, no send is attempted and claimed leads stay pending.
SHARPSPRING_POSTBACK_URL=
# Bearer secret for GET /api/cron/crm-sync (Vercel Cron sends it as Authorization: Bearer ...).
CRON_SECRET=
